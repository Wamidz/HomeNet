<Window x:Class="HomeNet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomeNet.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DockPanel>

            <Grid DockPanel.Dock="Top" Height="40" Background="Gray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="backButton" 
                        Grid.Column="0" 
                        Content="&lt;" 
                        Height="25" 
                        Width="30" 
                        Margin="10,0,5,0" 
                        VerticalAlignment="Center" 
                        IsEnabled="False"
                        Click="backButton_Click" />

                <Button x:Name="homeButton" 
                        Grid.Column="1" 
                        Content="⌂" 
                        Height="24" 
                        Width="30" 
                        Margin="0,0,5,8" 
                        VerticalAlignment="Bottom" 
                        Click="homeButton_Click" />

                <Button x:Name="forwardButton" 
                        Grid.Column="2" 
                        Content="&gt;" 
                        Height="25" 
                        Width="30" 
                        Margin="0,0,10,0" 
                        VerticalAlignment="Center" 
                        IsEnabled="False"
                        Click="forwardButton_Click" />

                <TextBox x:Name="searchBar" 
                         Grid.Column="3" 
                         Height="25" 
                         Margin="0,0,10,0" 
                         VerticalAlignment="Center" 
                         KeyDown="searchBar_KeyDown" />

                <ProgressBar x:Name="loadingProgressBar"
                             Grid.Column="4"
                             Width="80" Height="15"
                             Margin="0,0,10,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             VerticalAlignment="Center" />

                <Button x:Name="searchButton" 
                        Grid.Column="5" 
                        Content="Search" 
                        Height="25" 
                        Width="60" 
                        Margin="0,0,10,0" 
                        VerticalAlignment="Center" 
                        Click="searchButton_Click" />
            </Grid>

            <FlowDocumentScrollViewer x:Name="documentViewer" 
                         Margin="0" 
                         PreviewMouseWheel="documentViewer_PreviewMouseWheel">
                <FlowDocument x:Name="renderFlowDoc" />
            </FlowDocumentScrollViewer>
        </DockPanel>
    </Grid>
</Window>